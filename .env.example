# HERA environment variables
#
# Backend currently requires none -- all data is synthetic and in-process
# (see docs/API_CONTRACT.md, FAILSAFE section). This file exists so the
# convention is in place before frontend/map integrations need real keys
# (e.g. a maps/weather API key for the access-map service).
#
# BACKEND_PORT=8000

# --- Access map service (map/, see map/README.md) ---
# All optional. Unset = demo mode with synthetic data and no network calls.
# HERA_MAP_PORT=8001
# HERA_API_URL=http://127.0.0.1:8000     # read patients/providers from backend (falls back if down)
# HERA_DEMO_MODE=1                        # force fully offline synthetic mode
# HERA_CONDITIONS_SCENARIO=winter_storm   # or: clear
# HERA_LIVE_WEATHER=1                     # Open-Meteo forecast, no API key; falls back to scenario
# HERA_ROAD_EVENTS_URL=                   # GeoJSON road-events feed; falls back to scenario

# --- Frontend (frontend/.env.local) ---
# VITE_HERA_API_URL=http://127.0.0.1:8000
# VITE_HERA_MAP_URL=http://127.0.0.1:8001
